{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DatabaseSettings": {
    "Ip": "${DB_HOST}",
    "Port": 5432,
    "User": "${DB_USER}",
    "Password": "${DB_PASSWORD}",
    "Database": "${DB_NAME}"
  },
  "APIService": {
    "BaseUrlAccount": "http://localhost:8080"
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}


